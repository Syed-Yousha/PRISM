# PRISM .gitignore

# Environment variables (API keys - NEVER commit!)
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
ENV/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Manim media cache (regenerated on each run)
prism_mvp/media/Tex/
prism_mvp/media/texts/
prism_mvp/media/images/generated_scene/

# Audio output folders (generated per topic)
prism_mvp/media/audio/*/

# Do NOT ignore the music folder (contains bgm.mp3)
!prism_mvp/media/music/

# Video output (large files, regenerated)
prism_mvp/media/videos/generated_scene/

# Temp files
*.tmp
*.temp
temp-*
*.m4a

# Generated scene (changes each run)
prism_mvp/generated_scene.py

# ChromaDB (can be rebuilt with rag_builder.py)
# Uncomment if you want to exclude the vector database:
# vector_db/

# Bespoke cache (can be regenerated)
# prism_mvp/bespoke_cache/

# OS files
.DS_Store
Thumbs.db
