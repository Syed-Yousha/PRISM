          "2. Play Write(title, run_time=1.5)",
          "3. Create shape = Circle(radius=1.5, color=BLUE).move_to(ORIGIN)",
          "4. Play Create(shape, run_time=1.0)",
          "5. Wait(2.0) for narration to complete"
