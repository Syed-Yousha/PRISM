    {
      "id": 2,
      "type": "formula",
      "title": "Fraction Notation",
      "narration": "A fraction is represented as a/b, where a is the numerator and b is the denominator.",
      "duration_estimate": 12,
      "visual_mode": "2D",
      "blackboard_notes": [
        "Numerator",
        "Denominator",
        "Fraction notation"
      ],
      "animation_plan": {
        "step_by_step": [
          "1. Create fraction = MathTex(r'\\frac{a}{b}', font_size=48, color=WHITE).move_to(ORIGIN)",
          "2. Play Write(fraction, run_time=1.5)",
          "3. Create numerator = Text('Numerator', font_size=24, color=BLUE).next_to(fraction, UP, buff=0.2)",
          "4. Play Write(numerator, run_time=0.5)",
          "5. Create denominator = Text('Denominator', font_size=24, color=BLUE).next_to(fraction, DOWN, buff=0.2)",
          "6. Play Write(denominator, run_time=0.5)"
        ],
